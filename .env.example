# ========================================================
# SpeakFluent AI - Variáveis de Ambiente
# ========================================================

# 1. OBRIGATÓRIA NO BACKEND (Vercel & Local):
# Obtenha gratuitamente ou via plano pago em: https://aistudio.google.com/app/apikey
# No painel da Vercel: Project Settings -> Environment Variables -> GEMINI_API_KEY
GEMINI_API_KEY="AIzaSy..."

# 2. FIREBASE & GOOGLE DRIVE SYNC (OPCIONAL):
# O projeto já possui o arquivo 'firebase-applet-config.json' pré-configurado.
# Caso você prefira usar suas próprias credenciais do Firebase Console via variáveis:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# 3. URL DA APLICAÇÃO (OPCIONAL):
# Preenchida automaticamente pelo AI Studio / Vercel para links de referência:
APP_URL="http://localhost:3000"
